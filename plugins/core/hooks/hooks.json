{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "session-start"], "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "prompt"], "timeout": 5 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Agent",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "pre-tool-use"], "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Bash|Write|Edit",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "post-tool-use"], "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "stop"], "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "session-end"], "timeout": 5 }] }
    ],
    "SubagentStop": [
      {
        "matcher": "^wizardingcode-developer-crew:(judge|cto|tech-lead|researcher|expert|devils-advocate|fault-finder|review-code-quality|review-test-quality|review-security|review-ui-ux|review-risk|review-architecture|review-data|review-infra|lead-researchers|lead-qa|lead-security|lead-architects|lead-etl|lead-devops|lead-backend|lead-frontend|lead-agentic-os)$",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/crew.mjs", "hook", "subagent-stop"], "timeout": 10 }]
      }
    ]
  },
  "modules": ["./register.js"]
}
